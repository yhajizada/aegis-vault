# Application
NEXT_PUBLIC_APP_NAME="Nexus SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Prisma)
# SQLite for zero-config local development:
DATABASE_URL="file:./dev.db"

# Or PostgreSQL for production / Docker:
# DATABASE_URL="postgresql://nexus_user:nexus_password@localhost:5432/nexus_db?schema=public"

# Authentication Secret
AUTH_SECRET="your-super-secret-jwt-key-replace-in-production-min-32-chars"

# Analytics / Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
